{
  "name": "losim — decentralized systems lab",
  "image": "mcr.microsoft.com/devcontainers/java:25-bookworm",

  // Node is here for one thing that is not the simulator: developing the viewer.
  // Neither losim nor the manual needs it any more — both are served by the JDK
  // that is already here — and the toolchain losim builds and runs with is
  // vendored, so a number never depends on what a package manager resolved.
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },


  // Build losim so a fresh Codespace is ready to run, and say what to type.
  //
  // `./gradlew`, not `gradle`. The image above shipped a Gradle on sdkman's path
  // until it was rebuilt with an empty candidates directory, which left the PATH
  // entry pointing at nothing and this line failing before a student saw the
  // welcome text. The wrapper is committed, so what builds here no longer depends
  // on what the image happens to carry this month.
  "postCreateCommand": "./gradlew -q jar && cat .devcontainer/welcome.txt",

  // ...and start it, every time somebody attaches. The ports below are
  // forwarded and one of them opens a preview, so something has to be listening
  // on them — otherwise the first thing a student sees is a failed page. It is
  // on attach rather than on start because reconnecting to a container that has
  // been running for a week must also leave the lab up; `--detach` probes the
  // port first, so a second attach starts nothing and leaves no JVM behind.
  "postAttachCommand": "bin/dissaly serve --detach && bin/dissaly serve docs --detach",

  "forwardPorts": [3000, 8000],
  "portsAttributes": {
    "3000": { "label": "the manual", "onAutoForward": "notify" },
    "8000": { "label": "the lab", "onAutoForward": "openPreview" }

  },

  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "java.configuration.updateBuildConfiguration": "automatic",
        "java.project.referencedLibraries": ["vendor/jars/*.jar"],
        "files.exclude": { "**/build/losim/classes": true }
      }
    }
  }
}
