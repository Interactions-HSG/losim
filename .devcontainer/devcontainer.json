{
  "name": "losim — decentralized systems lab",
  "image": "mcr.microsoft.com/devcontainers/java:25-bookworm",

  // Build losim so a fresh Codespace is ready to run.
  "postCreateCommand": "bash .devcontainer/setup.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "java.configuration.updateBuildConfiguration": "automatic",
        "java.project.referencedLibraries": ["vendor/jars/*.jar"],
        "files.exclude": { "**/build/classes": true }
      }
    }
  }
}
