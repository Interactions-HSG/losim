#!/usr/bin/env sh
# The CLI, in losim's own repository. `bin/losim dev test`, `bin/losim serve`.
#
# Everything it does needs a current `build/losim.jar`, and building that is this
# file's job rather than any verb's: the commands under `losim dev` run *out of*
# that jar, and a Gradle jar task truncates its output in place — so a verb that
# rebuilt the jar it was executing would be reading a file being rewritten under
# it. Building before the JVM starts makes that impossible rather than unlikely.
#
# `bin/` rather than the root, for the one reason that the source lives in
# `losim/` and a file cannot be a directory. What `losim adopt` writes into a
# lab is this file at `./losim`, where nothing is in the way.
set -e
cd "$(dirname "$0")/.."

# The wrapper first, and it is committed, so this is the path every machine takes:
# it pins 9.2.0 and checks the download's sha256, which is the same reason the
# toolchain is vendored — a build must not depend on what somebody's package
# manager happened to resolve. It is also the only thing that works in a
# Codespace: the devcontainer image carried a Gradle until it was rebuilt without
# one, and a repository that cannot be built in the container it ships is a
# repository nobody can start.
G=./gradlew
[ -x "$G" ] || G="$(command -v gradle || true)"
[ -n "$G" ] || {
  echo "no gradle, and no ./gradlew — this repository ships one, so a clone is" >&2
  echo "incomplete. Restore it, or: brew install gradle" >&2
  exit 1
}

"$G" -q jar
exec java -cp build/losim.jar dissaly.cli.Main "$@"
