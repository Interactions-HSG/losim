{
  // losim's own sources, plus the protobuf the checks generate. Lab code will
  // compile against build/losim.jar alone, so a student cannot edit the simulator.
  "java.project.referencedLibraries": ["vendor/jars/*.jar"],
  "java.project.sourcePaths": ["losim/src", "losim/test/src", "build/test-gen"],
  "java.project.outputPath": "build/ide"
}
