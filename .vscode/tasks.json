{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "losim: build",
      "type": "shell",
      "command": "gradle -q jar",
      "group": "build",
      "problemMatcher": [
        "$tsc"
      ]
    },
    {
      "label": "losim: check",
      "type": "shell",
      "command": "bin/losim dev test",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "losim: reference suite",
      "type": "shell",
      "command": "bin/losim dev suite",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "docs: the manual (localhost:3000)",
      "type": "shell",
      "command": "bin/losim serve docs",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "silent" }
    },
    {
      "label": "losim: the lab (localhost:8000)",
      "type": "shell",
      "command": "bin/losim serve",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "silent" }
    },

    {
      "label": "docs: check for leaks",
      "type": "shell",
      "command": "bin/losim dev docs check",
      "group": "test",
      "problemMatcher": []
    }
  ]
}
