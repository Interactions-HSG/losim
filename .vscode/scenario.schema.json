{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "losim scenario",
  "description": "The instructor's dial-turning surface. Declarative data only: anything needing computation points at a Java class.",
  "type": "object",
  "required": ["name", "vms"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string" },
    "seed": { "type": "integer", "description": "Same seed, same run, byte for byte." },
    "run_until": { "type": "string", "pattern": "^[0-9.]+(ms|s|m)?$", "default": "30s" },
    "codec": { "enum": ["record", "proto"],
               "description": "record: schema-less. proto: field numbers, materially smaller." },
    "input": { "type": "string" },
    "prices": { "type": "string", "description": "Path to a price list. Course data, not library data." },
    "vms": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "program": { "type": "string" },
          "programs": { "type": "array", "items": { "type": "string" },
                        "description": "Several programs on one machine: colocation, and the combiner." },
          "instance": { "type": "string", "examples": ["t3.nano","t3.micro","m5.large","c5.xlarge","r5.large","r5.xlarge","i3.large"] },
          "availability_zone": { "oneOf": [ {"type":"string"}, {"type":"array","items":{"type":"string"}} ] },
          "market": { "enum": ["on-demand", "spot"] },
          "count": { "type": "integer", "minimum": 1 },
          "prefix": { "type": "string", "description": "Names members prefix0..prefixN." },
          "overrides": { "type": "object", "description": "Per-member, for a fleet that is uniform except one." }
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "topology": { "enum": ["mesh", "ring"] },
        "loss": { "type": "number", "minimum": 0, "maximum": 1 },
        "cross_zone_factor": { "type": "number" },
        "latency": {
          "type": "object", "additionalProperties": false,
          "properties": { "mean": {"type":"string"}, "stddev": {"type":"string"}, "dist": {"type":"string"} }
        }
      }
    },
    "faults": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["at"],
        "properties": {
          "at": { "type": "string" },
          "kill": { "type": "string" },
          "freeze": { "type": "string" },
          "degrade": { "type": "string" },
          "spot_reclaim": { "type": "string" },
          "exhaust_credits": { "type": "string" },
          "restart": { "type": "string" },
          "partition": { "type": "array" },
          "heal": { "type": "string" },
          "cpu": { "type": "number" },
          "for": { "type": "string" },
          "notice": { "type": "string" },
          "restart_after": { "type": "string" }
        }
      }
    },
    "invariants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["check"],
        "properties": {
          "name": { "type": "string" },
          "check": { "type": "string", "description": "A Java class implementing losim.api.Invariant, or a built-in." }
        }
      }
    },
    "sweep": { "type": "object" }
  }
}
